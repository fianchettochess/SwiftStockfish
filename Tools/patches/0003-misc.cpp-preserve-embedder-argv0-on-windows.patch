--- a/misc.cpp
+++ b/misc.cpp
@@ -604,15 +604,53 @@
 fs::path CommandLine::get_binary_directory(fs::path argv0) {
 
 #ifdef _WIN32
+    /*
+      Modified for SwiftStockfish, 2026-09-06 (GPLv3 5(a) modification notice).
+
+      Change relative to upstream Stockfish sf_19: the GetModuleFileNameW
+      override below now fires ONLY when argv[0] carries no directory of its own.
+
+      WHY: this engine is embedded, not launched. `sf_create`
+      (StockfishBridge.cpp) has exactly one channel for telling the engine where
+      the caller's NNUE nets live - a synthetic argv[0] of
+      `<netDirectory>/stockfish` handed to `UCIEngine`, from which
+      `Engine::binaryDirectory`, and therefore `Network::load`'s search path, are
+      derived. Upstream's override replaces that argv[0] with the real running
+      image, silently discarding the net directory.
+
+      SCOPE WIDENED IN sf_19, which is why this note is worth re-reading. Through
+      sf_18 the override sat behind `_MSC_VER` and so hit only clang targeting
+      the MSVC ABI; sf_19 moved it into `CommandLine::get_binary_directory` under
+      plain `_WIN32`, so it now fires for every Windows build including MinGW.
+
+      The failure mode this fixes is quiet and expensive to chase.
+      `Network::load_user_net` returns without a diagnostic when the file is
+      absent, so `uci`, `isready`, `setoption` and `position` all still answer
+      correctly and the engine looks healthy. `verify_networks()` is called
+      lazily, and only from `Engine::go`, `Engine::perft` and
+      `Engine::trace_eval` - so the FIRST search prints five `info string ERROR:`
+      lines and calls `exit(EXIT_FAILURE)`, taking the host process with it.
+
+      UPSTREAM BEHAVIOUR IS PRESERVED. The override exists because a bare
+      `stockfish` typed at a prompt yields an extensionless argv[0] with no
+      directory; that case has no parent path and still takes the API path. When
+      argv[0] DOES carry a directory, only `parent_path()` is ever used below, so
+      the missing `.exe` extension is irrelevant there. `has_parent_path()` is
+      the std::filesystem spelling of the separator search this patch used
+      against sf_18, and is path-aware rather than character-wise.
+    */
     // Prefer the executable path reported by Windows. Unlike _get_wpgmptr,
     // this does not depend on whether the CRT used a narrow or wide entry
     // point. Windows paths cannot exceed 32767 characters, so a fixed
     // buffer is always sufficient. Falls back to argv0 if the API fails.
-    constexpr DWORD MaxPath = 32768;
-    wchar_t         path[MaxPath];
+    if (!argv0.has_parent_path())
+    {
+        constexpr DWORD MaxPath = 32768;
+        wchar_t         path[MaxPath];
 
-    if (const DWORD length = GetModuleFileNameW(nullptr, path, MaxPath))
-        argv0 = fs::path(path, path + length);
+        if (const DWORD length = GetModuleFileNameW(nullptr, path, MaxPath))
+            argv0 = fs::path(path, path + length);
+    }
 #endif
 
     auto binaryDirectory = argv0.parent_path();
